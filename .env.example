# Copy to .env and fill in (never commit .env)

# Azure Cosmos DB (account > Keys)
COSMOS_ENDPOINT=https://<account-name>.documents.azure.com:443/
COSMOS_KEY=<primary-key>
COSMOS_DATABASE=couvert

# Firebase service account JSON (Project settings > Service accounts > Generate new private key)
# Currently the app uses the template project: template-react-native-b8abd
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
