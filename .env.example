# Copy to .env and fill in (never commit .env)

# Azure Cosmos DB (account > Keys)
COSMOS_ENDPOINT=https://<account-name>.documents.azure.com:443/
COSMOS_KEY=<primary-key>
COSMOS_DATABASE=CouvertApp

# Firebase service account (Project settings > Service accounts > Generate new private key)
# for the Couvert-owned project `couvert-app`. Locally, point at the file:
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Deployments use the JSON *content* instead, injected as a secret — a container
# has no file to mount. Set one or the other; JSON wins if both are present.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Browser origins allowed to call the API. The default covers Expo web on
# localhost; a deployment must name its real origins or the web build is blocked.
# Native apps send no Origin header and are unaffected.
# CORS_ORIGIN_REGEX=^https://couvert\.example\.com$

# How long the catalog is served from memory, and the client-facing max-age.
# The catalog only changes when a job runs; lower this while iterating on seed data.
# CONTENT_CACHE_SECONDS=600

# Places API (New) — offline jobs only, never the API. Every call is cached and
# capped (see jobs/resolve_google_maps.py). Do NOT deploy this key.
GOOGLE_MAPS_API_KEY=<places-api-key>
